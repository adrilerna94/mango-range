# URL base del servicio HTTP de rangos (mock en /api/range y /api/range-values).
# Copia este archivo a .env.local para desarrollo.
# Solo la usa el servidor (src/lib/api/range.api.ts), por eso no lleva el
# prefijo NEXT_PUBLIC_ y no se incrusta en el JavaScript del navegador.
# En local es la propia app. En Vercel se define en las variables de entorno
# del proyecto.
API_URL=http://localhost:8080
