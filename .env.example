# URL base del servicio HTTP de rangos (mock en /api/range y /api/range-values).
# Copia este archivo a .env.local para desarrollo.
# En producción, defínela en el entorno de BUILD del hosting: las variables
# NEXT_PUBLIC_ se incrustan en el código al compilar.
# `npm run build` prerenderiza los datos, así que necesita esta API accesible:
# levanta antes `npm run dev` o apunta a la URL de producción.
NEXT_PUBLIC_API_URL=http://localhost:8080
